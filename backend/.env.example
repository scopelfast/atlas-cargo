# Copie para .env e preencha. Não commite o .env.

# PostgreSQL
DB_SERVER=localhost
DB_PORT=5432
DB_DATABASE=atlas_cargo_prd
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=altere-esta-chave

# Duração da sessão do painel (torre) em horas: usada no JWT e na contagem de logins simultâneos (USUARIOLOGACESSO).
# TOWER_SESSION_TTL_HOURS=8
# Por padrão, o mesmo login (SGUSUARIO) só pode ter uma sessão torre aberta por vez (dois navegadores = 409 ou kick).
# Para permitir várias abas/navegadores com o mesmo usuário (ignora essa regra; o limite do plano SaaS continua valendo):
# TOWER_PERMITIR_MULTIPLAS_SESSOES_MESMO_USUARIO=S

# Multi-tenant (Fase 1): identificador lógico da instalação; vai no JWT até haver tenant por usuário.
# Fase 2: após deploy, executar no PostgreSQL o script backend/scripts/adicionar_tenant_id_fase2_postgres.sql
DEFAULT_TENANT_ID=default

# Porta HTTP do Node (API + estáticos)
PORT=3001

# URL pública para links de convocação, campanhas de oportunidades (WhatsApp) e páginas do motorista.
# Em produção: https://app.seudominio.com (sem barra no final). Obrigatório se o Node não recebe o Host real (proxy).
# Alternativa: PUBLIC_APP_BASE_URL (mesmo efeito se PUBLIC_URL estiver vazio).
PUBLIC_URL=http://localhost:3001

NODE_ENV=development

# Fase 5 — Produção: origens permitidas para CORS (ex.: https://app.seudominio.com). Vazio = aviso no log e comportamento permissivo.
# CORS_ORIGINS=https://localhost:3001,https://app.exemplo.com

# Limite de tentativas de login por IP (janela em ms, máximo de requisições)
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=40

# Opcional — app motorista
TELEFONE_SUPORTE=

# Fallback OpenAI (Whisper) se não houver chave salva em Configurações do Sistema
OPENAI_API_KEY=

# --- Job WMS: relatório de vencimento (e-mail opcional) ---
# Desative com N se não quiser o agendamento dentro do Node (pode usar só o script npm run wms:vencimento-once no cron).
# WMS_VENCIMENTO_JOB_ATIVO=S
# Intervalo entre ciclos (horas). Primeira execução após N minutos do boot.
# WMS_VENCIMENTO_JOB_INTERVALO_HORAS=24
# WMS_VENCIMENTO_JOB_PRIMEIRA_EXEC_MIN=120
# Destinatários do relatório (vírgula). Um e-mail por tenant que tiver linhas no horizonte.
# WMS_VENCIMENTO_JOB_EMAIL_TO=logistica@empresa.com,estoque@empresa.com
# SMTP (só envia se SMTP_HOST e WMS_VENCIMENTO_JOB_EMAIL_TO estiverem preenchidos)
# SMTP_HOST=smtp.empresa.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@empresa.com
# Para lab com certificado autoassinado: SMTP_TLS_REJECT_UNAUTHORIZED=false

# --- Job WMS: categoria automática (alta confiança; escopo dono + conservação) ---
# WMS_CATEGORIA_JOB_ATIVO=N
# WMS_CATEGORIA_JOB_DRY_RUN=S
# WMS_CATEGORIA_JOB_INTERVALO_HORAS=24
# WMS_CATEGORIA_JOB_PRIMEIRA_EXEC_MIN=240
# WMS_CATEGORIA_JOB_TENANT_ID=          # vazio = todos os tenants com dono WMS ativo
# WMS_CATEGORIA_JOB_CD_DONOS=           # vazio = TODOS os donos que têm produto sem categoria (recomendado em produção)
# WMS_CATEGORIA_JOB_CD_DONOS=1          # piloto: só um dono
# WMS_CATEGORIA_JOB_CD_DONOS=1,2,5      # opcional: lista explícita (vírgula ou ponto-e-vírgula)
