{
  "expo": {
    "name": "DivulgaCarga Motorista",
    "slug": "divulgacarga-motorista",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#667eea"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.divulgacarga.motorista",
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos acessar a câmera para capturar fotos de eventos.",
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para rastreamento durante a viagem.",
        "NSLocationAlwaysUsageDescription": "Precisamos da sua localização para rastreamento contínuo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#667eea"
      },
      "package": "com.divulgacarga.motorista",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
